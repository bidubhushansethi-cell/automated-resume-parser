# Copy this file to .env and fill in the values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL connection (use the password you set for your PostgreSQL user)
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resume_parser
# Or give one full URL instead of the DB_* values:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/resume_parser

# First HR login, created by: flask --app run init-db
ADMIN_USERNAME=hr_admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional
MAX_FILE_MB=5
MAX_FILES_PER_UPLOAD=20
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
